# Credenciales de Firebase (SDK Web). NO son secretas: identifican el proyecto.
# La seguridad real la dan las reglas de Firestore (firestore.rules).
# Cópialo a .env y rellena con los valores de tu consola de Firebase.
VITE_FIREBASE_API_KEY=tu_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
